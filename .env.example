NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Authentication: Social OAuth providers (Google, Apple, GitHub) are configured
# in your Supabase Dashboard under Authentication -> Providers.
# In Supabase Redirect URLs, add:
# - http://localhost:3000/auth/callback (Development)
# - https://your-production-domain.com/auth/callback (Production)

# AI Provider Configuration (Options: openrouter | gemini | openai)
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
GEMINI_API_KEY=
OPENAI_API_KEY=

# Image Provider Configuration (Options: ideogram)
IMAGE_PROVIDER=ideogram
IDEOGRAM_API_KEY=
IDEOGRAM_MODEL=

# Email / Notification Provider Configuration (Resend)
RESEND_API_KEY=

# Development/Testing: Use Resend test sender 'onboarding@resend.dev' (no custom domain required)
# Production: Change to verified domain e.g. 'notifications@swallern.com' or 'Swallern Notifications <notifications@swallern.com>'
RESEND_FROM_EMAIL=onboarding@resend.dev
ADMIN_NOTIFICATION_EMAIL=swallern@gmail.com

YOUTUBE_API_KEY=
SENTRY_DSN=
